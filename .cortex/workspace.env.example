# Workspace configuration — copy to .cortex/workspace.env and fill in your values.
# This file is gitignored; each developer maintains their own copy.

# The GitHub Issue number assigned to your current work
ISSUE_ID=

# The domain you are working in (BRF)
DOMAIN=BRF

# The logical database name (usually CORE)
DB_NAME=CORE

# Snowflake connection names from ~/.snowflake/connections.toml (one per account)
CONNECTION_DEV=FCRICKDEMO_DEV
CONNECTION_PROD=FCRICKDEMO_PROD

# Derived clone names (for reference, not configuration):
#   WIP clone:     WIP_<ISSUE_ID>_BRF_CORE_DB      (DEVACC)
#   TEST clone:    TEST_<ISSUE_ID>_BRF_CORE_DB     (DEVACC)
#   UAT clone:     UAT_<ISSUE_ID>_BRF_CORE_DB      (PRODACC)
#   PREPROD clone: PREPROD_<ISSUE_ID>_BRF_CORE_DB  (PRODACC)
#
# Session context per account:
#   DEVACC (WIP/TEST):
#     USE ROLE DEV_BRF_ETL;
#     USE WAREHOUSE BRF_WH;
#     USE DATABASE <WIP|TEST>_<ISSUE_ID>_BRF_CORE_DB;
#
#   PRODACC (UAT/PREPROD):
#     USE ROLE PROD_BRF_ETL;
#     USE WAREHOUSE BRF_WH;
#     USE DATABASE <UAT|PREPROD>_<ISSUE_ID>_BRF_CORE_DB;
