# Workspace configuration — copy to .cortex/workspace.env and fill in your values.
# This file is gitignored; each developer maintains their own copy.

# The GitHub Issue number assigned to your current work
ISSUE_ID=

# The domain you are working in (BRF)
DOMAIN=BRF

# The logical database name (usually CORE)
DB_NAME=CORE

# The Snowflake connection name from ~/.snowflake/connections.toml
CONNECTION=FCRICKDEMO_DEV

# Derived clone names (for reference, not configuration):
#   WIP clone:     WIP_<ISSUE_ID>_<DOMAIN>_<DB_NAME>_DB
#   TEST clone:    TEST_<ISSUE_ID>_<DOMAIN>_<DB_NAME>_DB
#   UAT clone:     UAT_<ISSUE_ID>_<DOMAIN>_<DB_NAME>_DB
#   PREPROD clone: PREPROD_<ISSUE_ID>_<DOMAIN>_<DB_NAME>_DB
#
# After connecting, CoCo sets the session context:
#   USE ROLE DEV_BRF_ETL;
#   USE WAREHOUSE BRF_DEV_WH;
#   USE DATABASE WIP_<ISSUE_ID>_BRF_CORE_DB;
